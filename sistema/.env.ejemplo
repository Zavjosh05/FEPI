# Copiar a .env y cambiar los valores. .env no se versiona.
# Sin .env, docker compose usa los valores de desarrollo de docker-compose.yml.

# Clave de Django: generar una nueva para cualquier servidor real, por ejemplo con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambiar-esta-clave
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Base de datos PostGIS (servicio bd)
BD_NOMBRE=probosque
BD_USUARIO=probosque
BD_CONTRASENA=cambiar-esta-contrasena

# Mapa base de Leaflet. Vacío = sin teselas (solo se dibujan el municipio y el polígono).
MAPA_TESELAS_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# 1 = cargar los datos de demostración al arrancar (manage.py cargar_demo, idempotente)
CARGAR_DEMO=1

# Fecha de corte de la demostración (AAAA-MM-DD, del 2026-11-19 al 2026-12-31). Vacía = el día en que se carga.
DEMO_FECHA_CORTE=
